    "version": "0.2.0",
    "configurations": [
        {
            "name": "Weedding App Python Debugger",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}" }
        }
    ]
}